<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Header using drawable resource -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_header"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="@dimen/screen_padding">

            <ImageView
                android:layout_width="@dimen/icon_size"
                android:layout_height="@dimen/icon_size"
                android:contentDescription="@string/app_name"
                android:src="@drawable/ic_book" />

            <TextView
                android:id="@+id/titleText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/card_spacing"
                android:text="@string/welcome_title"
                android:textColor="@color/white"
                android:textSize="@dimen/title_text_size"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/card_spacing"
                android:gravity="center"
                android:text="@string/welcome_message"
                android:textColor="@color/white"
                android:textSize="@dimen/subtitle_text_size" />

        </LinearLayout>

        <!-- Course card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/screen_padding"
            android:layout_marginTop="@dimen/card_spacing"
            android:layout_marginEnd="@dimen/screen_padding"
            android:background="@drawable/custom_background"
            android:orientation="vertical"
            android:padding="@dimen/card_padding">

            <TextView
                style="@style/CardTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/course_label" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/card_spacing"
                android:text="@string/course_value"
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/subtitle_text_size" />

        </LinearLayout>

        <!-- Semester card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/screen_padding"
            android:layout_marginTop="@dimen/card_spacing"
            android:layout_marginEnd="@dimen/screen_padding"
            android:background="@drawable/custom_background"
            android:orientation="vertical"
            android:padding="@dimen/card_padding">

            <TextView
                style="@style/CardTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/semester_label" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/card_spacing"
                android:text="@string/semester_value"
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/subtitle_text_size" />

        </LinearLayout>

        <Button
            android:id="@+id/readMoreBtn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="@dimen/card_spacing"
            android:layout_marginBottom="@dimen/screen_padding"
            android:backgroundTint="@color/primary"
            android:text="@string/btn_read_more"
            android:textColor="@color/white" />

    </LinearLayout>

</ScrollView>
